Public Class my_PB1
    Inherits System.Windows.Forms.PictureBox
    Public Sub dbl()
        Me.DoubleBuffered = False
    End Sub
    Protected Overrides Sub OnPaint(ByVal pe As System.Windows.Forms.PaintEventArgs)
        frmMain.DrawScene()
        If Me.Width <> frmMain.Splitter.SplitterDistance - 15 Then
            Return
        End If
        MyBase.OnPaint(pe)
    End Sub
End Class

Public Class RTB1_
    Inherits RichTextBox
    Private rt As New RichTextBox
    Private cnt As Integer = 0
    Public _Paint As Boolean = True
    Public _scrolling As Boolean = False
    Private old_SelectionStart As Integer
    Private old_SelectionLength As Integer

    Protected Overrides Sub WndProc(ByRef m As System.Windows.Forms.Message)
        '  Console.WriteLine(String.Format("Msg {0:X} - lParam {1:X} - WParam {2:X}", m.Msg, m.WParam, m.WParam) + vbCrLf)
        MyBase.WndProc(m)
    End Sub


    Protected Overrides Sub OnMouseMove(ByVal e As System.Windows.Forms.MouseEventArgs)
        If e.X < 8 Then
            If Me.Cursor <> Cursors.Arrow Then
                Me.Cursor = Cursors.Arrow
            End If

        Else
            If Me.Cursor <> Cursors.IBeam Then
                Me.Cursor = Cursors.IBeam
            End If
        End If

        MyBase.OnMouseMove(e)
    End Sub

    Protected Overrides Sub OnMouseDown(ByVal e As System.Windows.Forms.MouseEventArgs)
        frmMain._SELECTED = 1
        MyBase.OnMouseDown(e)
    End Sub
    Protected Overrides Sub OnMouseClick(ByVal e As System.Windows.Forms.MouseEventArgs)
        frmMain.RTB1_MouseClick(Me, e)
        MyBase.OnMouseClick(e)
    End Sub


    Protected Overrides Sub OnSelectionChanged(ByVal e As System.EventArgs)
        frmMain.RTB1_SelectionChanged(Me, e)
        MyBase.OnSelectionChanged(e)
    End Sub

    Protected Overrides Sub OnTextChanged(ByVal e As System.EventArgs)
        frmMain.RTB1_TextChanged(Me, e)
        MyBase.OnTextChanged(e)
    End Sub

    Protected Overrides Sub OnKeyPress(ByVal e As System.Windows.Forms.KeyPressEventArgs)
        Dim c As Char = e.KeyChar
        e.KeyChar = Char.ToUpper(c)
        MyBase.OnKeyPress(e)
    End Sub

End Class

