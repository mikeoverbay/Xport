Imports Tao.OpenGl
Module Menu_Events
    Dim busy As Boolean = False
    Public Sub _btn_process()
        frmMain.FILE_PROCESS_MODE = True
        Application.DoEvents()
        Application.DoEvents()
        Application.DoEvents()
        frmMain.btn_process.Enabled = False
        frmfilter.TopMost = True
        If Not un_docked_edit.Visible Then
            frmfilter.Location = New Point(frmMain.Location.X + frmMain.Splitter.Panel2.Location.X + (frmMain.Splitter.Panel2.Width / 2) - (frmfilter.Width / 2), _
                                         frmMain.Location.Y + frmMain.Splitter.Panel2.Location.Y + (frmMain.Splitter.Panel2.Height / 2) - (frmfilter.Height / 2))
        Else
            frmfilter.Location = New Point(un_docked_edit.Location.X + (un_docked_edit.Width / 2) - (frmfilter.Width / 2), _
                             un_docked_edit.Location.Y + (un_docked_edit.Height / 2) - (frmfilter.Height / 2))

        End If
        frmfilter.Show(frmMain)
        frmMain.DrawScene()
        frmMain.RTB1.Focus()
    End Sub

    Public Sub _btn_new()
        'new file

        If frmMain.btn_save_as.Enabled Then
            Select Case MsgBox("Save Changes?", MsgBoxStyle.YesNoCancel, "Save?")
                Case MsgBoxResult.Yes
                    Try
                        System.IO.File.WriteAllText(frmMain.path, frmMain.RTB1.Text)
                    Catch ex As Exception
                        MsgBox("Error.. " & vbCrLf & ex.Message, MsgBoxStyle.Exclamation, "File Read Error..")
                        Return
                    End Try
                Case MsgBoxResult.Cancel
                    Return
                Case MsgBoxResult.No
            End Select

        End If
        frmMain.RTB1.Text = ""
        frmMain.path = ""
        frmMain.delete_stl()
        frmMain.clear_selection()
        frmMain.clear_arrays()
        frmMain.make_plotlist()
        frmMain.draw_all()
        frmMain.disable_btns()
        frmMain.DrawScene()
    End Sub

    Public Sub _btn_open()
        zoom_window.TopMost = False
        frmMain.OpenFileDialog1.FilterIndex = My.Settings.open1_fliter_index
        frmMain.FILE_PROCESS_MODE = False

        frmMain.make_filter()
        If frmMain.OpenFileDialog1.ShowDialog(frmMain) = DialogResult.OK Then
            draw_presistent_selection = False ' clear
            _Loading = True
            ReDim presistent(1)
            frmMain.clear_selection()
            zoom_window.TopMost = True
            frmMain.open_file()
            If frmMain.codechop_loaded Then
                frmMain.delete_stl()
            End If
        Else
            _Loading = False
            zoom_window.TopMost = True

        End If
        My.Settings.open1_fliter_index = frmMain.OpenFileDialog1.FilterIndex
        frmMain.DrawScene()
        'End If

    End Sub

    Public Sub _btn_save()
        frmMain.make_filter()
        frmMain.SaveFileDialog1.FileName = file_root + file_name
        Try
            Dim s As String
            s = ""
            s = frmMain.RTB1.Text
            s = Microsoft.VisualBasic.Replace(s, vbLf, vbCrLf)
            System.IO.File.WriteAllText(file_root + file_name, s)
        Catch ex As Exception
            MsgBox("Error.. " & vbCrLf & ex.Message, MsgBoxStyle.Exclamation, "File Read Error..")
            Return
        End Try

    End Sub

    Public Sub _btn_save_as()
        frmMain.make_filter()
        frmMain.SaveFileDialog1.FileName = file_root + file_name
        zoom_window.TopMost = False
        If frmMain.SaveFileDialog1.ShowDialog(frmMain) = Windows.Forms.DialogResult.OK Then
            file_name = frmMain.SaveFileDialog1.FileName
            Try
                Dim s As String
                s = ""
                s = frmMain.RTB1.Text
                s = Microsoft.VisualBasic.Replace(s, vbLf, vbCrLf)
                System.IO.File.WriteAllText(file_name, s)
            Catch ex As Exception
                MsgBox("Error.. " & vbCrLf & ex.Message, MsgBoxStyle.Exclamation, "File Write Error..")
                Return
            End Try
            frmMain.Text = frmMain.App_Name + " : " + frmMain.get_filename()
        End If
        zoom_window.TopMost = True

    End Sub

    Public Sub _btn_copy()
        If frmMain.RTB1.SelectedText.Length > 0 Then
            Clipboard.SetText(frmMain.RTB1.SelectedText)
        End If

    End Sub

    Public Sub _btn_paste()
        If Clipboard.GetText.Length > 0 Then
            frmMain.RTB1.Paste()
        End If

    End Sub

    Public Sub _btn_delete()
        If frmMain.RTB1.SelectedText.Length > 0 Then
            frmMain.RTB1.SelectedText = ""
        End If

    End Sub

    Public Sub _btn_cut()
        If frmMain.RTB1.SelectedText.Length > 0 Then
            Clipboard.SetText(frmMain.RTB1.SelectedText)
            frmMain.RTB1.SelectedText = ""
        End If

    End Sub

    Public Sub _btn_undo()
        frmMain.Undo()
    End Sub

    Public Sub _btn_redo()
        frmMain.Redo()
    End Sub

    Public Sub _btn_find()
        frmMain.btn_find.Enabled = False
        frmMain.btn_find_next.Enabled = False
        frmMain.btn_replace.Enabled = False
        find_replace = False
        Find.Show(frmMain)
        If Not un_docked_edit.Visible Then
            Find.Location = New Point(frmMain.Location.X + frmMain.Splitter.Panel2.Location.X + (frmMain.Splitter.Panel2.Width / 2) - (Find.Width / 2), _
                                         frmMain.Location.Y + frmMain.Splitter.Panel2.Location.Y + (frmMain.Splitter.Panel2.Height / 2) - (Find.Height / 2))
        Else
            Find.Location = New Point(un_docked_edit.Location.X + (un_docked_edit.Width / 2) - (Find.Width / 2), _
                             un_docked_edit.Location.Y + (un_docked_edit.Height / 2) - (Find.Height / 2))

        End If
        frmMain.RTB1.Invalidate()
        frmMain.RTB1.Update()
        frmMain.RTB1.Focus()
    End Sub

    Public Sub _btn_find_next()
        If find_string.Length = 0 Then
            _btn_find()
        Else
            frmMain.btn_find_next.Enabled = False
            find_text()
            frmMain.btn_find_next.Enabled = True
            frmMain.RTB1.Focus()
        End If
    End Sub

