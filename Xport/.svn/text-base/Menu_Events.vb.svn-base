    'plot_toolbar buttons subs
    Public Sub _btn_rewind()
        busy = False
        frmMain.btn_step_back.Timer_.Enabled = False
        frmMain.btn_step_forward.Timer_.Enabled = False
        frmMain.btn_step_forward.reset()
        frmMain.btn_step_back.reset()
        first_step = True
        step_pos = 0
        frmMain._SELECTED = 0
        single_step = True
        frmMain.DrawScene()

    End Sub
    Public Sub _btn_plot_all()
        busy = False
        frmMain.btn_step_back.Timer_.Enabled = False
        frmMain.btn_step_forward.Timer_.Enabled = False
        frmMain.btn_step_forward.reset()
        frmMain.btn_step_back.reset()
        single_step = False
        first_step = True
        frmMain.draw_all()
        frmMain.RTB1.Focus()
    End Sub


    Public Sub _btn_step_back()
        If busy Then
            Return
        End If
        busy = True
        Application.DoEvents()
        Application.DoEvents()
        Application.DoEvents()
        If step_pos <= frmMain._SELECTED Then
            step_pos = frmMain._SELECTED
            frmMain.btn_step_back.reset()
            busy = False
            Return
        End If
        If first_step Then
            single_step = True
            step_pos = frmMain._SELECTED
            first_step = False
        End If
        'frmMain.DrawScene()
        If step_pos = 0 Then Return
        If frmMain._auto_center Then
            Try
                eye_x = draw_data(step_pos).ex
                eye_z = -draw_data(step_pos).ey
                eye_y = draw_data(step_pos).ez
            Catch ex As Exception
            End Try
        End If
        step_pos -= 1
        If Not frmMain.btn_step_back.locked Then
            select_txt(step_pos)
        End If
        Application.DoEvents()
        Application.DoEvents()
        Application.DoEvents()
        frmMain.DrawScene()
        frmMain.RTB1.Focus()
        busy = False
    End Sub
    Public Sub _btn_step_forward()
        If busy Then
            Return
        End If
        busy = True
        Application.DoEvents()
        Application.DoEvents()
        Application.DoEvents()
        If first_step Then
            single_step = True
            step_pos = frmMain._SELECTED
            first_step = False
        End If
        step_pos += 1
        If step_pos >= draw_data.Length - 1 Then ' stop auto repete if its on
            frmMain.btn_step_forward.Timer_.Enabled = False
            frmMain.btn_step_forward.reset()
        End If
        If frmMain._auto_center Then
            Try
                eye_x = draw_data(step_pos).ex
                eye_z = -draw_data(step_pos).ey
                eye_y = draw_data(step_pos).ez
            Catch ex As Exception
            End Try
        End If
        If Not frmMain.btn_step_forward.locked Then
            select_txt(step_pos)
        End If
        Application.DoEvents()
        Application.DoEvents()
        Application.DoEvents()
        frmMain.DrawScene()
        frmMain.RTB1.Focus()
        busy = False
    End Sub
    Public Sub _btn_light()
        Lighting.ShowDialog()
        'set light level
        frmMain.DrawScene()
    End Sub
    Public Sub _btn_solids()
        frmMain.btn_solids.Enabled = False
        If frmMain.OpenFileDialog2.ShowDialog = DialogResult.OK Then
            If frmMain.codechop_loaded Then
                frmMain.delete_stl()
            End If
            frmMain.build_stl(frmMain.OpenFileDialog2.FileName)
        End If
        frmMain.btn_solids.Enabled = True
    End Sub

    'subs
    Private Sub find_text()
        ' Dim st As New StringBuilder
        With frmMain
            Dim old_pos = .RTB1.SelectionStart
            '   st.Length = 0
            '
            Dim lines = .RTB1.Text.Split(ChrW(10))
            Dim pos As UInteger = 0
            Dim sel_start, sel_end As Integer
            Dim ts, te, fs As String
            If lines.Length = 0 Then
                frmMain.btn_find_next.Enabled = True
                Return
            End If
            ' .RTB1.SuspendLayout()
            sel_end = find_string.Length

            For pos = find_position To lines.Length - 1
                Dim ln = lines(pos)
                fs = ln
                If ln.Length = 0 Then GoTo skip ' not on this line
                sel_start = InStr(ln, find_string)
                If sel_start = 0 Then GoTo skip


                ts = Microsoft.VisualBasic.Mid(ln, 1, sel_start)
                te = Microsoft.VisualBasic.Mid(ln, sel_start + 1 + sel_end + 1)
                Dim s As UInteger = .RTB1.GetFirstCharIndexFromLine(pos)
                .RTB1.SelectionStart = (s + sel_start - 1)
                .RTB1.SelectionLength = sel_end
                .RTB1.ScrollToCaret()
                GoTo done
skip:
                Application.DoEvents()
                ' st.Append(fs + vbCrLf)
                If pos >= lines.Length Then
                    MsgBox("End Of File Reached...", MsgBoxStyle.OkOnly, "Search Completed")
                    find_position = 0
                    GoTo done
                End If
            Next
done:
            Application.DoEvents()
            '.RTB1.Text = st.ToString
            find_position = pos + 1
            If pos >= lines.Length Then
                MsgBox("End Of File Reached...", MsgBoxStyle.OkOnly, "Search Completed")
                find_position = 0
            End If

        End With
        ' frmMain.Focus()
    End Sub
    Private Sub select_txt(ByVal selected As Integer)
        Try
            Dim text_pnt As Integer = draw_data(selected).text_pnt
            Dim loc As Integer = frmMain.RTB1.GetFirstCharIndexFromLine(text_pnt)
            Dim e_loc As Integer = frmMain.RTB1.GetFirstCharIndexFromLine(text_pnt + 1)

            frmMain.RTB1.Select(loc, e_loc - loc - 1)
        Catch ex As Exception

        End Try
    End Sub
End Module
