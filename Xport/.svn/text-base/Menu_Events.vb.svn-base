    'modal subs
    Public Sub _btn_show_plot()
        If frmMain.btn_show_plot.Checked Then
            frmMain.btn_split_direction.Enabled = True
            frmMain.Splitter.Panel2Collapsed = False
            frmMain.RTB1.Width = frmMain.Splitter.Panel1.Width - 15
        Else
            frmMain.btn_split_direction.Enabled = False
            frmMain.Splitter.Panel2Collapsed = True
            frmMain.RTB1.Width = frmMain.Splitter.Panel1.Width - 15
        End If
        frmMain.DrawScene()
    End Sub

