Imports System
Imports System.Drawing
Imports System.Windows.Forms
'Imports System.Windows.Forms.VisualStyles



Public Class my_Btn

    Inherits Windows.Forms.Button
    Public state As Boolean = False
    Protected Overrides Sub OnMouseEnter(ByVal e As System.EventArgs)
        Me.BackgroundImage = My.Resources.BTN_M_OVER
        MyBase.OnMouseEnter(e)
    End Sub
    Protected Overrides Sub OnMouseDown(ByVal mevent As System.Windows.Forms.MouseEventArgs)
        Application.DoEvents()
        Me.BackgroundImage = My.Resources.BTN_M_DOWN
        Me.state = True
        MyBase.OnMouseDown(mevent)
    End Sub
    Protected Overrides Sub OnMouseLeave(ByVal e As System.EventArgs)
        Me.state = False
        Me.BackgroundImage = My.Resources.BTN_M_UP
        MyBase.OnMouseLeave(e)
    End Sub
    Protected Overrides Sub OnMouseUp(ByVal mevent As System.Windows.Forms.MouseEventArgs)
        Me.state = False
        Me.BackgroundImage = My.Resources.BTN_M_OVER
        MyBase.OnMouseUp(mevent)
    End Sub
    Protected Overrides Sub OnParentChanged(ByVal e As System.EventArgs)
        MyBase.OnParentChanged(e)
        Me.FlatStyle = Windows.Forms.FlatStyle.Flat
        Me.FlatAppearance.BorderSize = 0
        Me.Text = ""
        Me.AutoSize = False
        Me.Width = 32
        Me.Height = 32
        Me.ImageAlign = ContentAlignment.MiddleCenter
        Me.BackgroundImage = My.Resources.BTN_M_UP
    End Sub
    Protected Overrides Sub OnEnabledChanged(ByVal e As System.EventArgs)
        Me.BackgroundImage = My.Resources.BTN_M_UP
        MyBase.OnEnabledChanged(e)
    End Sub

End Class

Public Class my_repeat_btn_forward
    Inherits Windows.Forms.Button
    Public flip As Boolean = False
    Public locked As Boolean
    Public Sub New()
        AddHandler Timer_.Tick, AddressOf OnTimer
        Timer_.Enabled = False
    End Sub

    Public Timer_ As New System.Windows.Forms.Timer
    Public Property Interval() As Integer
        Get
            Return Timer_.Interval
        End Get

        Set(ByVal Value As Integer)
            Timer_.Interval = Value
        End Set
    End Property

    Private Sub OnTimer(ByVal sender As Object, ByVal e As EventArgs)
        Timer_.Interval = step_time
        Application.DoEvents()
        If Me.locked Then
            If flip Then
                Me.BackgroundImage = My.Resources.BTN_M_DOWN
                flip = False
            Else
                Me.BackgroundImage = My.Resources.BTN_M_OVER
                flip = True
            End If
        End If
        'fire off a click on each timer tick 
        _btn_step_forward()
        Application.DoEvents()

    End Sub


    Protected Overrides Sub OnMouseEnter(ByVal e As System.EventArgs)
        If Me.locked Then
        Else
            Timer_.Enabled = False
            Timer_.Interval = 1000
            Me.BackgroundImage = My.Resources.BTN_M_OVER
        End If
        MyBase.OnMouseEnter(e)
    End Sub
    Protected Overrides Sub OnMouseDown(ByVal mevent As System.Windows.Forms.MouseEventArgs)
        If mevent.Button = Windows.Forms.MouseButtons.Right Then
            If Me.locked Then
                Me.locked = False
                Timer_.Interval = 1000
            Else
                Timer_.Interval = 10
                Me.locked = True
            End If
        Else
            Me.locked = False
            Timer_.Interval = 1000
        End If
        If frmMain.btn_step_back.locked Then
            frmMain.btn_step_back.reset()
        End If
        Timer_.Enabled = True
        Me.BackgroundImage = My.Resources.BTN_M_DOWN
        MyBase.OnMouseDown(mevent)
    End Sub
    Protected Overrides Sub OnMouseLeave(ByVal e As System.EventArgs)
        If Me.locked Then
        Else
            Timer_.Enabled = False
            Me.BackgroundImage = My.Resources.BTN_M_UP
        End If
        MyBase.OnMouseLeave(e)
    End Sub
    Protected Overrides Sub OnMouseUp(ByVal mevent As System.Windows.Forms.MouseEventArgs)
        If mevent.Button = Windows.Forms.MouseButtons.Right Then
        Else
            Me.locked = False
            Timer_.Enabled = False
            Me.BackgroundImage = My.Resources.BTN_M_OVER

        End If
        MyBase.OnMouseUp(mevent)
    End Sub
    Protected Overrides Sub OnParentChanged(ByVal e As System.EventArgs)
        MyBase.OnParentChanged(e)
        Me.FlatStyle = Windows.Forms.FlatStyle.Flat
        Me.FlatAppearance.BorderSize = 0
        Me.Text = ""
        Me.AutoSize = False
        Me.Width = 32
        Me.Height = 32
        Me.ImageAlign = ContentAlignment.MiddleCenter
        Me.BackgroundImage = My.Resources.BTN_M_UP
        Me.TabStop = False
    End Sub
    Protected Overrides Sub OnEnabledChanged(ByVal e As System.EventArgs)
        Me.BackgroundImage = My.Resources.BTN_M_UP
        MyBase.OnEnabledChanged(e)
    End Sub
    Public Sub reset()
        Me.locked = False
        Timer_.Enabled = False
        Me.BackgroundImage = My.Resources.BTN_M_UP
    End Sub
End Class

Public Class my_repeat_btn_back
    Inherits Windows.Forms.Button
    Public flip As Boolean = False
    Public locked As Boolean
    Public Sub New()
        AddHandler Timer_.Tick, AddressOf OnTimer
        Timer_.Enabled = False
    End Sub

    Public Timer_ As New System.Windows.Forms.Timer
    Public Property Interval() As Integer
        Get
            Return Timer_.Interval
        End Get

        Set(ByVal Value As Integer)
            Timer_.Interval = Value
        End Set
    End Property

    Private Sub OnTimer(ByVal sender As Object, ByVal e As EventArgs)
        Timer_.Interval = step_time
        Application.DoEvents()
        If Me.locked Then
            If flip Then
                Me.BackgroundImage = My.Resources.BTN_M_DOWN
                flip = False
            Else
                Me.BackgroundImage = My.Resources.BTN_M_OVER
                flip = True
            End If
        End If
        'fire off a click on each timer tick 
        _btn_step_back()
        Application.DoEvents()
    End Sub


    Protected Overrides Sub OnMouseEnter(ByVal e As System.EventArgs)
        If Me.locked Then
        Else
            Timer_.Enabled = False
            Timer_.Interval = 1000
            Me.BackgroundImage = My.Resources.BTN_M_OVER
        End If
        MyBase.OnMouseEnter(e)
    End Sub
    Protected Overrides Sub OnMouseDown(ByVal mevent As System.Windows.Forms.MouseEventArgs)
        If mevent.Button = Windows.Forms.MouseButtons.Right Then
            If Me.locked Then
                Me.locked = False
                Timer_.Interval = 1000
            Else
                Timer_.Interval = 10
                Me.locked = True
            End If
        Else
            Me.locked = False
            Timer_.Interval = 1000
        End If
        If frmMain.btn_step_forward.locked Then
            frmMain.btn_step_forward.reset()
        End If
        Timer_.Enabled = True
        Me.BackgroundImage = My.Resources.BTN_M_DOWN
        MyBase.OnMouseDown(mevent)
    End Sub
    Protected Overrides Sub OnMouseLeave(ByVal e As System.EventArgs)
        If Me.locked Then
        Else
            Timer_.Enabled = False
            Me.BackgroundImage = My.Resources.BTN_M_UP
        End If
        MyBase.OnMouseLeave(e)
    End Sub
    Protected Overrides Sub OnMouseUp(ByVal mevent As System.Windows.Forms.MouseEventArgs)
        If mevent.Button = Windows.Forms.MouseButtons.Right Then
        Else
            Me.locked = False
            Timer_.Enabled = False
            Me.BackgroundImage = My.Resources.BTN_M_OVER

        End If
        MyBase.OnMouseUp(mevent)
    End Sub
    Protected Overrides Sub OnParentChanged(ByVal e As System.EventArgs)
        MyBase.OnParentChanged(e)
        Me.FlatStyle = Windows.Forms.FlatStyle.Flat
        Me.FlatAppearance.BorderSize = 0
        Me.Text = ""
        Me.AutoSize = False
        Me.Width = 32
        Me.Height = 32
        Me.ImageAlign = ContentAlignment.MiddleCenter
        Me.BackgroundImage = My.Resources.BTN_M_UP
        Me.TabStop = False
    End Sub
    Protected Overrides Sub OnEnabledChanged(ByVal e As System.EventArgs)
        Me.BackgroundImage = My.Resources.BTN_M_UP
        MyBase.OnEnabledChanged(e)
    End Sub
    Public Sub reset()
        Me.locked = False
        Timer_.Enabled = False
        Me.BackgroundImage = My.Resources.BTN_M_UP
    End Sub
End Class

